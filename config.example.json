{
  "server": {
    "addr": "127.0.0.1:18080"
  },
  "data_file": "data/orders.json",
  "database_file": "data/tvbot.db",
  "trading": {
    "env": "demo",
    "allow_live_trading": false,
    "base_url": "https://www.okx.com",
    "binance_base_url": "https://fapi.binance.com",
    "binance_demo_base_url": "https://demo-fapi.binance.com",
    "default_margin_mode": "isolated",
    "position_mode": "net",
    "signal_ttl_seconds": 120,
    "order_amount_usdt": 100,
    "leverage": 5,
    "order_type": "market",
    "risk_type": "tp_sl",
    "take_profit_pct": 2,
    "stop_loss_pct": 1,
    "trailing_pct": 1,
    "long_limit_price_multiplier": 0.997,
    "short_limit_price_multiplier": 1.003,
    "fill_monitor": {
      "enabled": true,
      "poll_interval_seconds": 20,
      "lookback_hours": 72,
      "exchange": ["binance"]
    },
    "auto_reentry": {
      "enabled": false,
      "max_reentries": 1,
      "reentry_amount_pct": 50,
      "cooldown_after_stop_hours": 24,
      "only_bot_orders": true
    },
    "position_monitor": {
      "okx_enabled": false,
      "binance_enabled": false,
      "poll_interval_seconds": 300,
      "take_profit_pct": 5,
      "stop_loss_pct": 8
    }
  },
  "symbols": {
    "BTC": {
      "coinpair": "BTC",
      "inst_id": "BTC-USDT-SWAP",
      "ct_val": 0.01,
      "lot_sz": 0.01,
      "min_sz": 0.01
    },
    "ETH": {
      "coinpair": "ETH",
      "inst_id": "ETH-USDT-SWAP",
      "ct_val": 0.1,
      "lot_sz": 0.01,
      "min_sz": 0.01
    }
  },
  "ui": {
    "default_tab": "dashboard",
    "menu_items": [
      { "tab": "dashboard", "hidden": false, "label": "总览" },
      { "tab": "positions", "hidden": false, "label": "持仓" },
      { "tab": "analysis", "hidden": false, "label": "订单分析" },
      { "tab": "symbols", "hidden": false, "label": "币对配置" },
      { "tab": "config", "hidden": false, "label": "订单配置" },
      { "tab": "apiKeys", "hidden": false, "label": "API Key" },
      { "tab": "orderSettings", "hidden": false, "label": "下单设置" },
      { "tab": "template", "hidden": false, "label": "告警模板" },
      { "tab": "orders", "hidden": false, "label": "订单" },
      { "tab": "tradeMonitor", "hidden": false, "label": "成交监听" },
      { "tab": "menuSettings", "hidden": false, "label": "菜单设置" },
      { "tab": "upgrade", "hidden": false, "label": "升级" }
    ],
    "table_columns": {
      "positions": [
        "exchange",
        "symbol",
        "side",
        "size",
        "avg_price",
        "margin",
        "leverage",
        "position_amount",
        "mark_price",
        "upl",
        "return_rate",
        "entry_time",
        "holding_time",
        "actions"
      ],
      "pending_orders": [
        "exchange",
        "time",
        "symbol",
        "side",
        "position_side",
        "type",
        "price",
        "mid_price",
        "size",
        "margin",
        "filled",
        "state",
        "actions"
      ],
      "symbols": [
        "env",
        "symbol",
        "configured",
        "state",
        "base_quote",
        "settle",
        "ct_val",
        "min_size",
        "lot_size",
        "leverage",
        "turnover"
      ]
    }
  }
}
