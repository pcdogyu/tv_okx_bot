# Required for TradingView template generation and /tvorder validation.
TV_TOKEN_SECRET=replace-with-long-random-secret

# Browser/API admin auth. Defaults in code are admin/Admin123, but override them in production.
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123

# Optional API token auth kept for automation clients.
ADMIN_TOKEN=

# OKX credentials.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Demo is default. For live trading, also set config trading.env=live and allow_live_trading=true.
OKX_ENV=demo
ALLOW_LIVE_TRADING=false

# /upgrade runtime settings.
TV_OKX_WORKDIR=/opt/tv_okx_bot
TV_OKX_BINARY=/opt/tv_okx_bot/tv-okx-bot
TV_OKX_SERVICE=tv-okx-bot.service
TV_OKX_RESTART_CMD=/usr/bin/sudo /bin/systemctl restart tv-okx-bot.service

