[Unit]
Description=TradingView OKX Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tvokx
Group=tvokx
WorkingDirectory=/opt/tv_okx_bot
EnvironmentFile=/etc/tv-okx-bot/tv-okx-bot.env
Environment=HOME=/var/lib/tv-okx-bot
Environment=GOCACHE=/var/lib/tv-okx-bot/.cache/go-build
Environment=GOMODCACHE=/var/lib/tv-okx-bot/go/pkg/mod
ExecStart=/opt/tv_okx_bot/tv-okx-bot serve --config /etc/tv-okx-bot/config.json --addr 127.0.0.1:18080
Restart=always
RestartSec=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/tv_okx_bot /etc/tv-okx-bot /var/lib/tv-okx-bot

[Install]
WantedBy=multi-user.target
